APP_NAME="Syllabus to Coursera Recommender"
APP_ENV="development"
APP_SECRET_KEY="replace-with-a-long-random-secret"
CORS_ORIGINS="*"

# PostgreSQL + pgvector recommended for production:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/coursera_recommender"
# SQLite fallback for local quickstart:
DATABASE_URL="sqlite:///./app.db"

JWT_ALGORITHM="HS256"
JWT_EXP_MINUTES=480

# Embeddings:
# - local-hash: deterministic local fallback
# - openai: use OpenAI embeddings
EMBEDDING_PROVIDER="local-hash"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=""

# Coursera ingestion adapters
COURSERA_API_BASE_URL="https://api.coursera.org/api"
COURSERA_API_TOKEN=""
COURSERA_API_PAGE_SIZE=100
COURSERA_DEFAULT_FEED_PATH="data/coursera_sample_feed.json"

# Optional bootstrap admin for first run
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Admin User"
BOOTSTRAP_ADMIN_DEPARTMENT="Information Systems"
